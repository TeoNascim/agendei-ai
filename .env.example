# Variáveis de Ambiente — Agendei AI

# ── Servidor (Vercel Serverless Function) ─────────────────────────────────────
# Google Gemini API Key — usada APENAS no backend (api/gemini.ts).
# NÃO use o prefixo VITE_ aqui: isso evita expor a chave no browser.
GOOGLE_API_KEY=sua_chave_gemini_aqui

# ── Frontend (exposto ao browser via Vite) ────────────────────────────────────
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anon_supabase_aqui
